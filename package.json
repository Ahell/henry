{
  "name": "henry-course-planner",
  "type": "module",
  "version": "1.0.0",
  "description": "Henry Course Planner - Full-stack kursplaneringsapp f\u00f6r FEI",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "start:prod": "node server/server.js",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "health:check": "node scripts/health-check.mjs",
    "test": "node --test server/tests/*.test.js",
    "start": "node server/server.js",
    "clean": "rm -rf dist node_modules server/node_modules",
    "install:server": "cd server && npm install",
    "postinstall": "npm ci --prefix server",
    "user:add": "node scripts/user.mjs"
  },
  "keywords": [
    "course-planning",
    "education",
    "lit",
    "webcomponents",
    "express",
    "sqlite"
  ],
  "author": "FEI",
  "license": "MIT",
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.0.0",
    "concurrently": "^8.2.2",
    "vite": "^5.0.7"
  }
}
